{
  "name": "aurelius-radar",
  "version": "1.0.0",
  "private": true,
  "description": "Kreatif Atelier / Aurelius - Commercial Client Intelligence & Social Radar",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "catalogue:import": "tsx scripts/import-catalogue.ts",
    "selftest": "tsx scripts/selftest.ts",
    "send": "set -a && . ./.env.local && set +a && tsx scripts/send-local.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@prisma/client": "^6.0.0",
    "cheerio": "^1.0.0",
    "exceljs": "^4.4.0",
    "imapflow": "^1.7.8",
    "leaflet": "^1.9.4",
    "next": "^15.0.0",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.20.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.24",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
